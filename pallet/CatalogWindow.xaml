<Window x:Class="pallet.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pallet"
        mc:Ignorable="d"
        Title="Каталог паллет"
        Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6A1B9A" Offset="0"/>
                    <GradientStop Color="#8E24AA" Offset="0.6"/>
                    <GradientStop Color="#AB47BC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <Border Grid.Column="0"
                        Width="42" Height="42"
                        Background="White"
                        CornerRadius="10"
                        Margin="0,0,15,0">
                    <Image Source="pack://application:,,,/image.png"
                           Width="36" Height="36"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Название -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Продажа паллет"
                               FontSize="19" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Каталог товаров"
                               FontSize="11"
                               Foreground="#E1BEE7"/>
                </StackPanel>

                <!-- ФИО пользователя -->
                <Border Grid.Column="2"
                        Background="#40FFFFFF"
                        CornerRadius="20"
                        Padding="15,8"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtUserInfo"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Корзина -->
                <Button Grid.Column="3"
                        x:Name="BtnCart"
                        Content="🛒  Корзина (0)"
                        Height="42" Padding="20,0"
                        FontSize="14"
                        Background="White"
                        Foreground="{StaticResource PrimaryDarkBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="BtnCart_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="#F3E5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Выход -->
                <Button Grid.Column="4"
                        x:Name="BtnLogout"
                        Content="Выйти"
                        Height="42" Padding="20,0"
                        FontSize="14"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="#40FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="#80FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ФИЛЬТРЫ -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20,14"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource ModernTextBox}"
                         Width="280"
                         Margin="0,0,20,0"/>

                <TextBlock Text="Категория:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbCategory"
                          Style="{StaticResource ModernComboBox}"
                          Width="200"
                          Margin="0,0,20,0"/>

                <Button Content="Найти"
                        Width="110" Height="38"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSearch_Click"/>
            </StackPanel>
        </Border>

        <!-- СПИСОК ТОВАРОВ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="0"
                                Padding="18"
                                Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#6A1B9A"
                                                  BlurRadius="12"
                                                  ShadowDepth="1"
                                                  Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Картинка товара -->
                                <Border Grid.Column="0"
                                        Width="110" Height="110"
                                        CornerRadius="0"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImageFallback}}"
                                           Width="100" Height="100"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="18,0">
                                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производство | {0}'}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                               Margin="0,2,0,10"/>
                                    <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Quantity, StringFormat='Количество: {0} шт.'}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Quantity, Converter={StaticResource StockColor}}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Composition, StringFormat='Состав: {0}'}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Цена и кнопка -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} ₽'}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryLightBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,12"/>
                                    <Button Content="В корзину"
                                            x:Name="BtnAddToCart"
                                            Width="150" Height="40"
                                            Style="{StaticResource PrimaryButton}"
                                            Tag="{Binding ProductID}"
                                            Click="BtnAddToCart_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- СТАТУСБАР -->
        <Border Grid.Row="3"
                Background="#F3E5F5"
                Padding="20,8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus"
                       Text="Готово"
                       FontSize="12"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>
        </Border>
    </Grid>
</Window>